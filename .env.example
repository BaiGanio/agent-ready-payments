# Copy to .env and change the value. .env is gitignored.
# No '$' in the password. Docker Compose reads '$' as a variable and eats the
# rest of the word, so the container would get a different password than this file.
# Letters, digits, '_', '-' and '!' are safe.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# Lab 08: raw API keys. Make each with:  openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
# The database stores only their SHA-256. See docs/EVERYDAY-COMMANDS.md -> "API keys".
PAYMENTS_DEV_KEY=
PAYMENTS_AGENT_KEY=
PAYMENTS_READONLY_AGENT_KEY=

# Lab 09: the local model. scripts/llm.sh reads this line and starts llama-server with it.
# Rung 1 (small, makes the mistakes the guard tests want). Rung 3 is the bigger one:
#   unsloth/gemma-4-26B-A4B-it-GGUF:UD-Q4_K_XL
LLM_HF_MODEL=unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
# The context window, in tokens. Measured 2026-10-23 on an M1 Pro with rung 1: 16384 cost
# 5.49 GB and 98304 cost 6.75 GB, so about 16 MB per 1K tokens. 65536 leaves room for the
# 26B rung 3 model, whose KV cache is far fatter per token. Keep it the SAME for both rungs,
# or the step 23 scores are not comparable.
LLM_CTX=65536
# LLM_PORT=8080
