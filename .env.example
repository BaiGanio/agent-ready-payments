# Copy to .env and change the value. .env is gitignored.
# No '$' in the password. Docker Compose reads '$' as a variable and eats the
# rest of the word, so the container would get a different password than this file.
# Letters, digits, '_', '-' and '!' are safe.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# Lab 08: raw API keys. Make each with:  openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
# The database stores only their SHA-256. See docs/EVERYDAY-COMMANDS.md -> "API keys".
PAYMENTS_DEV_KEY=
PAYMENTS_AGENT_KEY=
PAYMENTS_READONLY_AGENT_KEY=
