<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- No Microsoft.Data.SqlClient line: EF Core's SqlServer provider brings it through
         Payments.Agent, and Payments.Migrations pins the Pkcs package it drags in (CF-010). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Payments.Agent\Payments.Agent.csproj" />
    <ProjectReference Include="..\Payments.Testing\Payments.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SqlServerDatabase, StubApi and ApiFixture all live in Payments.Testing (step 3).
         A global using means no test file has to learn it. -->
    <Using Include="Payments.Testing" />
  </ItemGroup>

</Project>
