{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Payments.Db",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Payments.Db/bin/Debug/net10.0/Payments.Db.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "Attach to a running .NET process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
